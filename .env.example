# Copy to .env and fill in. .env must NOT be committed.
# Create the database first:
#   CREATE DATABASE musicapp CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/musicapp?charset=utf8mb4
SECRET_KEY=change-me
# Optional: where uploaded audio/cover files are stored (default: ./uploads) and max upload size.
# UPLOAD_FOLDER=
# MAX_UPLOAD_MB=50
